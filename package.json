{
  "name": "public-rogue-tech",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/generate-sitemap.mjs",
    "watch": "ng build --watch --configuration development",
    "generate:api": "openapi-generator-cli generate -i http://localhost:8081/v3/api-docs -g typescript-angular -o src/app/api --additional-properties=stringEnums=true,serviceSuffix=Service",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "^21.0.1",
    "@angular/common": "~21.2.20",
    "@angular/compiler": "~21.2.20",
    "@angular/core": "~21.2.20",
    "@angular/forms": "~21.2.20",
    "@angular/localize": "^21.2.20",
    "@angular/platform-browser": "~21.2.20",
    "@angular/platform-server": "~21.2.20",
    "@angular/router": "~21.2.20",
    "@angular/ssr": "^21.2.19",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@ngrx/signals": "^21.1.0",
    "@popperjs/core": "^2.11.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "~21.2.20",
    "@openapitools/openapi-generator-cli": "^2.32.0",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
